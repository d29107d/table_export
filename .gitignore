# ═══════════ Python ═══════════
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ═══════════ 打包产物（PyInstaller）═══════════
build/
dist/

# ═══════════ 运行产物 ═══════════
output/

# ═══════════ 本机配置（存的是绝对路径，换机器就失效）═══════════
# 程序首次启动会自动重建该目录，无需入库
config/

# ═══════════ 本机路径（对拍脚本用，含绝对路径，不入库）═══════════
tools/compare_paths.json

# ═══════════ 工作区数据（AI 记忆 / 技能 / 临时脚本）═══════════
.workbuddy/
_t_*.py

# ═══════════ 编辑器 / 系统垃圾 ═══════════
.vscode/
.idea/
*.swp
# Excel / WPS 打开文档时生成的临时锁文件
~$*
Thumbs.db
Desktop.ini
NVIDIA Corporation/

# ═══════════ macOS ═══════════
# 访达打开过目录就会生成；打包出的 .app 一旦被 Finder 选中，也会在 dist/ 下冒出来
.DS_Store
._*
.Spotlight-V100/
.Trashes/
